# Backend config (loaded by the backend via dotenv).
# Copy to .env and fill in. `!` = required. See README "Run / setup" for details.

NODE_ENV
HOST
PORT

# Required in production (comma-separated allowed browser origins).
ALLOWED_ORIGINS!

# Optional.
# LOG_LEVEL
# HOOKS_PORT
# DATA_DIR
# DUMP_DIR
# PTY_COLS
# PTY_ROWS
