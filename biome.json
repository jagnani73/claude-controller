{
    "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "organizeImports": {
        "enabled": true
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 80
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "all",
            "arrowParentheses": "always",
            "bracketSpacing": true
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "correctness": {
                "noUnusedImports": "error",
                "noUnusedVariables": "warn",
                "useExhaustiveDependencies": "warn",
                "useHookAtTopLevel": "error"
            },
            "style": {
                "noNonNullAssertion": "warn",
                "useConst": "error",
                "useImportType": "error"
            },
            "suspicious": {
                "noExplicitAny": "warn"
            }
        }
    },
    "files": {
        "ignore": [
            "dist/",
            "node_modules/",
            "*.min.js",
            "bun.lockb",
            ".claude/"
        ]
    },
    "overrides": [
        {
            "include": ["packages/frontend/**/*.tsx", "packages/frontend/**/*.ts"],
            "linter": {
                "rules": {
                    "correctness": {
                        "useExhaustiveDependencies": "warn",
                        "useHookAtTopLevel": "error"
                    }
                }
            }
        },
        {
            "include": ["**/parser.service.ts"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noControlCharactersInRegex": "off"
                    }
                }
            }
        }
    ]
}
